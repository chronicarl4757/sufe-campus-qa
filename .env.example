DEEPSEEK_API_KEY=sk-your-key-here
# 可选：覆盖数据目录（默认 <仓库>/data）
# SUFE_QA_DATA_DIR=/path/to/data

# 管理员 Dashboard 必填：使用密码管理器生成长随机串，不要提交真实值
# SUFE_QA_ADMIN_TOKEN=replace-with-a-long-random-token

# 可选：问答服务运行参数（均有默认值，一般无需设置）
# SUFE_QA_LLM_TIMEOUT=60            # DeepSeek 请求超时（秒）
# SUFE_QA_MAX_CONCURRENT_LLM=8      # 全局 LLM 并发闸
# SUFE_QA_MAX_QUESTION_CHARS=500    # 单问业务上限（字符）
# SUFE_QA_RATE_LIMIT_PER_MINUTE=12  # 单 IP 每分钟问答/反馈上限

# 可选：We-MP-RSS 文章发现服务（公众号抓取的 discovery 层，不配置则 crawl-wechat --mode werss 自动跳过）
# WERSS_BASE_URL=http://127.0.0.1:8001
# WERSS_ACCESS_KEY=
# WERSS_SECRET_KEY=
